# Server-side AI integration. Never expose these to the browser.
# Users can also save a personal key from the "AI Gemini" menu after login;
# a saved user key takes precedence over these environment defaults.
# If both providers are set here, Gemini takes precedence.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HTTP server port
PORT=3000
