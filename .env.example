# Server-side AI integration. Never expose these to the browser.
# The single-user workspace can also save a key from the "AI Gemini" menu;
# a saved workspace key takes precedence over these environment defaults.
# If both providers are set here, Gemini takes precedence.
# gemini-3.6-flash is the best model verified with the supplied key. Gemini 4
# and 3.1 Pro return quota=0 on free tier for this key; 3.8 Flash is often 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HTTP server port
PORT=3000
